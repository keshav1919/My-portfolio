rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'keshav88474267@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // User Profile Rules
    match /users/{userId} {
      // Admin can read all users, authenticated user can read their own profile
      allow read: if isOwner(userId) || isAdmin();

      // Creation allowed during signup
      allow create: if isOwner(userId);

      // Updates: Normal user can update non-privileged fields; Admin can update all fields including role/status
      allow update: if (
        isAdmin() ||
        (
          isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'email', 'uid'])
        )
      );

      // Deletion restricted to Admin
      allow delete: if isAdmin();

      // User Subcollection: Favorites
      match /favorites/{favId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // User Subcollection: Roadmap Progress
      match /roadmapProgress/{roadmapId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Content Collections: Tools, Commands, Shortcuts, Resources, Roadmaps
    match /tools/{toolId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /commands/{commandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shortcuts/{shortcutId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resources/{resourceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /roadmap_frontend/{stepId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /roadmap_javascript/{stepId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /roadmap_react/{stepId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin Audit Logs
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
